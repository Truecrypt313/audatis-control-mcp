# Synthetic placeholders; never commit actual credentials.
# HTTPS origin only. REST paths are fixed by the integration.
AUDATIS_BASE_URL=https://your-audatis-host.example
AUDATIS_CLIENT_ID=12345
AUDATIS_ALLOWED_CLIENT_ID=12345
AUDATIS_API_TOKEN=YOUR_API_TOKEN_HERE
AUDATIS_MCP_TOOL_NAMES=modern
# Unset or all: complete catalog. Explicit profiles need a server restart.
AUDATIS_MCP_MODULES=all
# Example: core,incidents,risks,compliance,measures,personnel
# Optional local contract. Empty explicitly selects base mode.
AUDATIS_OPENAPI_SPEC_PATH=
# Default SHA-256 pin is in management_catalog.py. Only override after private review.
# Optional operator-defined private report root (default: ignored copilot-output/).
# AUDATIS_COPILOT_OUTPUT_DIR=/ABSOLUTE/PRIVATE/OUTPUT
